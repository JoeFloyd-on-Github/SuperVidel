[{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/391228054","assets_url":"https://api.github.com/repos/mikrosk/ct60tos/releases/391228054/assets","upload_url":"https://uploads.github.com/repos/mikrosk/ct60tos/releases/391228054/assets{?name,label}","html_url":"https://github.com/mikrosk/ct60tos/releases/tag/3.00","id":391228054,"author":{"login":"mikrosk","id":3062260,"node_id":"MDQ6VXNlcjMwNjIyNjA=","avatar_url":"https://avatars.githubusercontent.com/u/3062260?v=4","gravatar_id":"","url":"https://api.github.com/users/mikrosk","html_url":"https://github.com/mikrosk","followers_url":"https://api.github.com/users/mikrosk/followers","following_url":"https://api.github.com/users/mikrosk/following{/other_user}","gists_url":"https://api.github.com/users/mikrosk/gists{/gist_id}","starred_url":"https://api.github.com/users/mikrosk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikrosk/subscriptions","organizations_url":"https://api.github.com/users/mikrosk/orgs","repos_url":"https://api.github.com/users/mikrosk/repos","events_url":"https://api.github.com/users/mikrosk/events{/privacy}","received_events_url":"https://api.github.com/users/mikrosk/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBHwEr84XUaqW","tag_name":"3.00","target_commitish":"master","name":"CT60 TOS 3.00","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-09-18T13:40:24Z","updated_at":"2026-09-18T13:43:42Z","published_at":"2026-09-18T05:02:28Z","assets":[],"tarball_url":"https://api.github.com/repos/mikrosk/ct60tos/tarball/3.00","zipball_url":"https://api.github.com/repos/mikrosk/ct60tos/zipball/3.00","body":"Brand new release, based on latest CT60 TOS 1.03f. It is still compatible with plain (no SuperVidel) CT6x boards but you are going to lose the boot picture.\r\n\r\nIt brings two major changes:\r\n\r\n- Built-in SuperVidel XBIOS so you can boot in 1920x1080x32bpp:\r\n<img width=\"3655\" height=\"2269\" alt=\"boot\" src=\"https://github.com/user-attachments/assets/bfbb0eaa-de70-4424-ae0c-79565cdb26f3\" />\r\n\r\n- CT60CONF.CPX now controls the SV XBIOS instead of SV.INF (there's no way to load it before hard disk is visible):\r\n<img width=\"263\" height=\"203\" alt=\"cpx\" src=\"https://github.com/user-attachments/assets/dc30c33d-3d8f-4e6a-b5e0-c29f5377bb14\" />\r\n\r\n- and yes, the boot picture and delay is gone, too.\r\n\r\nIn the future there might be CTPCI support added as @shoggoth77 did an excellent job in hooking up SuperVidel's capabilities to existing 8bpp / 16bpp / 32bpp chunky routines so in theory, only very little has to be done to support CTPCI in the same way.","mentions_count":1},{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/391204050","assets_url":"https://api.github.com/repos/mikrosk/ct60tos/releases/391204050/assets","upload_url":"https://uploads.github.com/repos/mikrosk/ct60tos/releases/391204050/assets{?name,label}","html_url":"https://github.com/mikrosk/ct60tos/releases/tag/1.03f","id":391204050,"author":{"login":"mikrosk","id":3062260,"node_id":"MDQ6VXNlcjMwNjIyNjA=","avatar_url":"https://avatars.githubusercontent.com/u/3062260?v=4","gravatar_id":"","url":"https://api.github.com/users/mikrosk","html_url":"https://github.com/mikrosk","followers_url":"https://api.github.com/users/mikrosk/followers","following_url":"https://api.github.com/users/mikrosk/following{/other_user}","gists_url":"https://api.github.com/users/mikrosk/gists{/gist_id}","starred_url":"https://api.github.com/users/mikrosk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikrosk/subscriptions","organizations_url":"https://api.github.com/users/mikrosk/orgs","repos_url":"https://api.github.com/users/mikrosk/repos","events_url":"https://api.github.com/users/mikrosk/events{/privacy}","received_events_url":"https://api.github.com/users/mikrosk/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBHwEr84XUUzS","tag_name":"1.03f","target_commitish":"master","name":"CT60 TOS 1.03f","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-09-18T04:47:03Z","updated_at":"2026-09-18T04:50:24Z","published_at":"2026-09-18T03:54:26Z","assets":[],"tarball_url":"https://api.github.com/repos/mikrosk/ct60tos/tarball/1.03f","zipball_url":"https://api.github.com/repos/mikrosk/ct60tos/zipball/1.03f","body":"Just a quick bugfix-release to prepare base for the upcoming SuperVidel flavour:\r\n\r\n- Fix a return value when calling a cartridge boot\r\n- Enlarge AUTO stack to 4 KB\r\n- Skip the SDRAM clear when the boot delay is zero\r\n- Support 29F800 flash chips with top boot block\r\n- Detect EC/LC models\r\n- Fix wrong month calculation in the version string\r\n- Further Videl safety fixes"},{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/342518735","assets_url":"https://api.github.com/repos/mikrosk/ct60tos/releases/342518735/assets","upload_url":"https://uploads.github.com/repos/mikrosk/ct60tos/releases/342518735/assets{?name,label}","html_url":"https://github.com/mikrosk/ct60tos/releases/tag/1.03e","id":342518735,"author":{"login":"mikrosk","id":3062260,"node_id":"MDQ6VXNlcjMwNjIyNjA=","avatar_url":"https://avatars.githubusercontent.com/u/3062260?v=4","gravatar_id":"","url":"https://api.github.com/users/mikrosk","html_url":"https://github.com/mikrosk","followers_url":"https://api.github.com/users/mikrosk/followers","following_url":"https://api.github.com/users/mikrosk/following{/other_user}","gists_url":"https://api.github.com/users/mikrosk/gists{/gist_id}","starred_url":"https://api.github.com/users/mikrosk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikrosk/subscriptions","organizations_url":"https://api.github.com/users/mikrosk/orgs","repos_url":"https://api.github.com/users/mikrosk/repos","events_url":"https://api.github.com/users/mikrosk/events{/privacy}","received_events_url":"https://api.github.com/users/mikrosk/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBHwEr84UamvP","tag_name":"1.03e","target_commitish":"ct60e","name":"CT60 TOS 1.03e","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-06-21T09:17:59Z","updated_at":"2026-06-21T13:09:00Z","published_at":"2026-06-21T12:22:30Z","assets":[],"tarball_url":"https://api.github.com/repos/mikrosk/ct60tos/tarball/1.03e","zipball_url":"https://api.github.com/repos/mikrosk/ct60tos/zipball/1.03e","body":"Nearly 21 years later there is another update for CT60 TOS 1.03c (1.03d was just a simple binary patch). It is a set of small fixes I have accumulated over the years, compatible with all CT60, CT63 and CT60e releases:\r\n- Backport some changes from CTPCI TOS 2.02 (there are still some interesting bits left out but I wanted to minimise the risk of introducing new bugs)\r\n- Fix the weird state when ST/TT RAM test finishes: https://www.atari-forum.com/viewtopic.php?t=35035\r\n- Fix slowness reported in CT60 TOS when using emulated instructions: https://www.dhs.nu/bbs-ct60/index.php?request=12235 (look for \"TEST 6\" at http://gtello.free.fr/kronos_soft.htm) **\\*1**\r\n- Don't corrupt Atari logo on SuperVidel (code taken from insane's CT60 TOS 1.05)\r\n- Don't try to detect internal and external video clocks when SuperVidel is present (hopefully good enough to work around the SuperVidel lockup on early boot: https://www.atari-forum.com/viewtopic.php?p=439917#p439917)\r\n- Fix the inverted double lines / interlace flag when switching between RGB and VGA\r\n- Remove the infamous 5s cache delay code so people can stop wondering why Quake runs at 1 FPS **\\*2**\r\n- Fix CAS/CAS2 emulation: https://atari-forum.com/viewtopic.php?p=467731#p467731\r\n- Don't clear FPCR register when processing FP exceptions (done by  Holger Schulz's 060sp for some reason which got importend into FreeMiNT and from FreeMiNT to CT60 TOS; now it is fixed everywhere)\r\n- Fix FPSP bug fetching an immediate single-precision constant: https://atari-forum.com/viewtopic.php?p=467696#p467696 **\\*3**\r\n- Remove the reboot code, file creation and alert related to CT60TEMP.{ACC,APP} from `CT60CONF.CPX` **\\*4**\r\n- Make Flash060 and CT60CONF.CPX easily compilable directly from the archive (see the \"build\" folder) **\\*5**\r\n\r\nNotes:\r\n\r\n1. Now the whole supervisor stack is moved into TT RAM so other functions should be faster (e.g. AES) and hopefully more stable (the stack is much bigger now)\r\n2. This has one important consequence: **you must install 060sp.prg when booting into FreeMiNT / MagiC!** FreeMiNT is preconfigured that way by default in recent snapshots but if you have your own mint.cnf, you must add that line there. Even though it seems like a downgrade/regression, what CT60 TOS did was a dirty hack which had to be removed.\r\n3. [dml's FPUTest 1.51](https://www.leonik.net/dml/sec_fpu.py) has pre-recorded its results with the bug present, use a corrected results file: https://atari-forum.com/viewtopic.php?p=497092#p497092 until a new version is available\r\n4. Code for communication with CT60TEMP is still kept. So if you have CT60TEMP.{ACC,APP} present on C:, it will be used (temperature reading when the CPX is closed, CPU load in mint/magic, powering the computer off at certain hour) ... btw there was a bug when you just copied `XCNTROL6.ACC` into C:\\  without renaming it to `XCONTROL.ACC` ... I bet many users never saw the reboot alert thanks to this omission. ;) (now fixed)\r\n5. `CT60CONF.CPX` was obviously recompiled and so was `FLASH060.PRG` although the latter contains just cosmetic changes against Willy's version -- PRG flags set back to 0x07 and the RSC files contain an updated version string.\r\n","reactions":{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/342518735/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":4,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/4822857","assets_url":"https://api.github.com/repos/mikrosk/ct60tos/releases/4822857/assets","upload_url":"https://uploads.github.com/repos/mikrosk/ct60tos/releases/4822857/assets{?name,label}","html_url":"https://github.com/mikrosk/ct60tos/releases/tag/2.01","id":4822857,"author":{"login":"mikrosk","id":3062260,"node_id":"MDQ6VXNlcjMwNjIyNjA=","avatar_url":"https://avatars.githubusercontent.com/u/3062260?v=4","gravatar_id":"","url":"https://api.github.com/users/mikrosk","html_url":"https://github.com/mikrosk","followers_url":"https://api.github.com/users/mikrosk/followers","following_url":"https://api.github.com/users/mikrosk/following{/other_user}","gists_url":"https://api.github.com/users/mikrosk/gists{/gist_id}","starred_url":"https://api.github.com/users/mikrosk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikrosk/subscriptions","organizations_url":"https://api.github.com/users/mikrosk/orgs","repos_url":"https://api.github.com/users/mikrosk/repos","events_url":"https://api.github.com/users/mikrosk/events{/privacy}","received_events_url":"https://api.github.com/users/mikrosk/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBHwEr84ASZdJ","tag_name":"2.01","target_commitish":"01b9056659bbccda7881b88ed3ea1f467a1a0e94","name":"tos060.lzh 2.01 & tos_drivers.lzh 1.01","draft":false,"immutable":false,"prerelease":false,"created_at":"2024-01-07T14:32:26Z","updated_at":"2024-01-07T15:13:03Z","published_at":"2024-01-07T15:13:03Z","assets":[],"tarball_url":"https://api.github.com/repos/mikrosk/ct60tos/tarball/2.01","zipball_url":"https://api.github.com/repos/mikrosk/ct60tos/zipball/2.01","body":""},{"url":"https://api.github.com/repos/mikrosk/ct60tos/releases/4822853","assets_url":"https://api.github.com/repos/mikrosk/ct60tos/releases/4822853/assets","upload_url":"https://uploads.github.com/repos/mikrosk/ct60tos/releases/4822853/assets{?name,label}","html_url":"https://github.